# Workspace env vars auto-loaded by direnv and by the nautilus_competition
# harness's _env.py priority chain.
#
# This file is for NON-SECRET workspace defaults. Real secrets (Binance
# testnet creds for live-paper mode) live in the sibling
# ~/Projects/workspace/nautilus-trading/.envrc and are auto-discovered.
# Put any workspace-local overrides in .env.local (gitignored).

# Telemetry: push competition metrics to the local pushgateway.
# Pair with `docker compose -f docker-compose.observability.yml up -d`
# (Grafana on :3000, Prometheus on :9090, pushgateway on :9091).
# IMPORTANT: this is the gateway BASE URL — no /metrics suffix.
# prometheus_client.push_to_gateway() appends /metrics/job/<name> itself.
export COMPETE_METRICS_ENDPOINT="http://localhost:9091"
export PYTHONUNBUFFERED=1export BINANCE_TESTNET_API_KEY="Qrn2GstRm5VuM6iW5aXFDw7G6BViF1bsSlqw0cg2nqgMm7VmXA7qXYdcUH5W5wpg"
export BINANCE_TESTNET_API_SECRET="$(cat /Users/rc/Projects/workspace/nautilus-trading/binance_ed25519_private.pem)"
