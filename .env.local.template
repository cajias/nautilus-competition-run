# Copy this file to .env.local and fill in IF you need workspace-local overrides.
# In most cases you don't need this file at all — the harness's `_env.py`
# auto-loads from the sibling `~/Projects/workspace/nautilus-trading/.envrc`
# in priority order (process env > workspace .env.local > sibling .env.local
# > workspace .envrc > sibling .envrc).
#
# Required for `paper.mode: live` (Binance Spot Testnet):
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional: Ed25519 key path. If unset, `_env.ensure_ed25519_key_path()`
# auto-discovers `~/Projects/workspace/nautilus-trading/binance_ed25519_private.pem`.
BINANCE_TESTNET_ED25519_KEY_PATH=
