# Copy this file to .env.local and fill in.
# Only required for `paper.mode: live` (Binance Spot Testnet).
# `paper.mode: simulated` (default in config.yaml) needs none of these.

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# Optional: Ed25519 key path for Binance signature scheme.
# If unset, the harness's eval._env.ensure_ed25519_key_path() will error in live mode.
BINANCE_TESTNET_ED25519_KEY_PATH=
