# nautilus-competition-run — TEST_V2 config (Task #7 step 2)
# Live-mode smoke at 1800s budget. Restore from config.yaml.production after.

name: smoke_live

# Match demo's catalog grid (5-min bars, 2025-01-01..2025-01-04).
# Single round, full demo span across train/test/eval/paper.
windows:
  - train:
      start: "2025-01-01T00:00:00Z"
      end:   "2025-01-02T17:40:00Z"
    test:
      start: "2025-01-02T17:40:00Z"
      end:   "2025-01-03T10:20:00Z"
    eval:
      start: "2025-01-03T10:20:00Z"
      end:   "2025-01-04T03:00:00Z"
    paper:
      start: "2025-01-04T03:00:00Z"
      end:   "2025-01-04T11:20:00Z"

paper:
  mode: live                          # Binance Spot Testnet — real API calls
  duration_minutes: 1                 # short live run; testnet creds auto-load
  starting_pot_usdt: 1000.0

instrument:
  symbol: "BTCUSDT.BINANCE"
  bar_type: "BTCUSDT.BINANCE-5-MINUTE-LAST-EXTERNAL"

agent:
  command: ["claude", "--print", "--output-format", "json"]
  per_train_timeout_seconds: 1800     # bumped from 600 — fs_reasoning_split's merger needs the room
  max_train_iterations: 1

scoring:
  weights:
    sharpe: 0.0
    total_return: 1.0
    max_drawdown: 0.0

catalog:
  path: data/catalog
